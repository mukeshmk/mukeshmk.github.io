---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const projects = await getCollection(
    'projects',
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;

const linkEntries = Object.entries(data.links ?? {}).filter(
  ([, url]) => Boolean(url)
) as ['github' | 'live' | 'paper', string][];

const linkLabels: Record<string, string> = {
  github: 'View code',
  live: 'Live site',
  paper: 'Read paper',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.description,
  keywords: data.tech.join(', '),
  author: { '@type': 'Person', name: site.name, url: site.url },
  url: new URL(`/projects/${project.id}`, site.url).href,
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  jsonLd={jsonLd}
  noindex={data.draft}
>
  <article class="mx-auto max-w-3xl px-6 pt-32 pb-20">
    <a
      href="/#projects"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300"
    >
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Back to projects
    </a>

    <header class="mt-6">
      {
        data.draft && (
          <p class="mb-3 inline-block rounded-md bg-amber-100 px-2 py-1 text-xs font-bold uppercase tracking-wide text-amber-800 dark:bg-amber-500/15 dark:text-amber-300">
            Draft
          </p>
        )
      }
      {
        data.year && (
          <p class="text-sm font-medium text-slate-400 dark:text-slate-500">
            {data.year}
          </p>
        )
      }
      <h1
        class="mt-2 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl dark:text-white"
      >
        {data.title}
      </h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
        {data.description}
      </p>

      <ul class="mt-4 flex flex-wrap gap-2">
        {data.tech.map((t) => <li><Badge variant="accent">{t}</Badge></li>)}
      </ul>

      {
        linkEntries.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {linkEntries.map(([kind, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-accent-400 dark:hover:text-accent-300"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <path d="M15 3h6v6M10 14 21 3" />
                </svg>
                {linkLabels[kind] ?? kind}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div
      class="prose prose-slate mt-10 max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-accent-600 prose-a:no-underline hover:prose-a:underline dark:prose-a:text-accent-400 prose-pre:border prose-pre:border-slate-200 dark:prose-pre:border-slate-800"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
