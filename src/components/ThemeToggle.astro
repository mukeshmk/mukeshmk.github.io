---
// Theme toggle button. The actual theme application happens in the no-FOUC
// inline script in BaseLayout (runs before paint); this button just flips it.
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white/60 text-slate-600 transition-colors hover:bg-slate-100 hover:text-accent-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-accent-300"
  aria-label="Toggle color theme"
  aria-pressed="false"
>
  <!-- Sun icon (shown in dark mode -> click to go light) -->
  <svg
    class="hidden h-5 w-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <!-- Moon icon (shown in light mode -> click to go dark) -->
  <svg
    class="block h-5 w-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
</button>

<script>
  const KEY = 'theme';
  const btn = document.getElementById('theme-toggle');

  function isDark() {
    return document.documentElement.classList.contains('dark');
  }

  function sync() {
    btn?.setAttribute('aria-pressed', String(isDark()));
  }

  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    document.documentElement.classList.toggle('dark', next === 'dark');
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* ignore storage errors (private mode etc.) */
    }
    sync();
  });

  sync();
</script>
