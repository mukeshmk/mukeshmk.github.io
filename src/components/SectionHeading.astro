---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, align = 'left' } = Astro.props;
const alignment = align === 'center' ? 'text-center' : 'text-left';
---

<div class={`mb-10 ${alignment}`}>
  {
    eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
        {eyebrow}
      </p>
    )
  }
  <h2
    class="mt-2 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl dark:text-white"
  >
    {title}
  </h2>
  <div
    class={`mt-4 h-1 w-16 rounded-full bg-gradient-to-r from-accent-500 to-brand-600 ${
      align === 'center' ? 'mx-auto' : ''
    }`}
  >
  </div>
</div>
