---
import Badge from './Badge.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  href: string;
}
const { title, description, date, tags, href } = Astro.props;

const dateStr = date.toLocaleDateString('en-IE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = date.toISOString().split('T')[0];
---

<article
  class="group relative flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 transition-all hover:-translate-y-1 hover:border-accent-400 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900 dark:hover:border-accent-500/50"
>
  <time datetime={isoDate} class="text-xs font-medium text-slate-400 dark:text-slate-500">
    {dateStr}
  </time>
  <h3 class="mt-2 text-lg font-bold text-slate-900 dark:text-white">
    <a href={href} class="after:absolute after:inset-0">
      <span class="bg-gradient-to-r from-accent-500 to-brand-600 bg-[length:0%_2px] bg-left-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_2px]">
        {title}
      </span>
    </a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
    {description}
  </p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {tags.map((tag) => <li><Badge>{tag}</Badge></li>)}
  </ul>
</article>
