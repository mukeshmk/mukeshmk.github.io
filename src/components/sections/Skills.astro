---
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import Badge from '../Badge.astro';
import { profile } from '../../data/site';

const skillGroups = (await getCollection('skills'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => e.data);

const certifications = (await getCollection('certifications'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => e.data);

const honors = profile.honors;
---

<section
  id="skills"
  class="mx-auto max-w-6xl scroll-mt-20 px-6 py-20"
  aria-labelledby="skills-heading"
>
  <SectionHeading eyebrow="Toolbox" title="Skills & credentials" />

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      skillGroups.map((group) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="mb-3 font-bold text-slate-900 dark:text-white">
            {group.title}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <li>
                <Badge>{skill}</Badge>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <div
      class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900"
    >
      <h3 class="mb-4 font-bold text-slate-900 dark:text-white">
        Certifications
      </h3>
      <ul class="space-y-3">
        {
          certifications.map((cert) => {
            const primaryHref = cert.link ?? cert.file;
            return (
              <li class="flex items-start gap-3">
                <svg
                  class="mt-0.5 h-5 w-5 flex-none text-accent-500"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                  <path d="M8.5 14 7 22l5-3 5 3-1.5-8" />
                </svg>
                <div>
                  {primaryHref ? (
                    <a
                      href={primaryHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm font-semibold text-slate-800 transition-colors hover:text-accent-600 dark:text-slate-200 dark:hover:text-accent-300"
                    >
                      {cert.name}
                    </a>
                  ) : (
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">
                      {cert.name}
                    </p>
                  )}
                  <p class="text-xs text-slate-500 dark:text-slate-400">
                    {cert.issuer}
                    {cert.year && <> &middot; {cert.year}</>}
                    {cert.file && cert.file !== primaryHref && (
                      <>
                        {' '}&middot;{' '}
                        <a
                          href={cert.file}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-medium text-accent-600 hover:underline dark:text-accent-400"
                        >
                          PDF
                        </a>
                      </>
                    )}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div
      class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900"
    >
      <h3 class="mb-4 font-bold text-slate-900 dark:text-white">
        Honors & awards
      </h3>
      <ul class="space-y-3">
        {
          honors.map((honor) => (
            <li class="flex items-start gap-3 text-sm text-slate-600 dark:text-slate-400">
              <svg
                class="mt-0.5 h-5 w-5 flex-none text-brand-500"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="8" r="6" />
                <path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5" />
              </svg>
              <span>{honor}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
