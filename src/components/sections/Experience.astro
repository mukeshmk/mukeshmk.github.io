---
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import Badge from '../Badge.astro';

const roles = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => e.data);

const education = (await getCollection('education'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => e.data);
---

<section
  id="experience"
  class="scroll-mt-20 border-y border-slate-200 bg-slate-50 py-20 dark:border-slate-800 dark:bg-slate-900/50"
  aria-labelledby="experience-heading"
>
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading eyebrow="Career" title="Experience" />

    <ol class="relative space-y-8 border-l border-slate-200 pl-6 dark:border-slate-700">
      {
        roles.map((role) => (
          <li class="relative">
            <span
              class={`absolute -left-[31px] top-1.5 h-3.5 w-3.5 rounded-full border-2 ${
                role.current
                  ? 'border-accent-500 bg-accent-500'
                  : 'border-slate-300 bg-white dark:border-slate-600 dark:bg-slate-900'
              }`}
              aria-hidden="true"
            />
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                    {role.title}
                  </h3>
                  <p class="text-sm text-slate-500 dark:text-slate-400">
                    {role.company} &middot; {role.location}
                  </p>
                </div>
                {role.current ? (
                  <Badge variant="accent">{role.period}</Badge>
                ) : (
                  <Badge>{role.period}</Badge>
                )}
              </div>
              <p class="mt-3 text-sm font-medium text-slate-600 dark:text-slate-300">
                {role.summary}
              </p>
              <ul class="mt-3 space-y-2">
                {role.highlights.map((h) => (
                  <li class="flex gap-2 text-sm text-slate-600 dark:text-slate-400">
                    <svg
                      class="mt-1 h-4 w-4 flex-none text-accent-500"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m5 12 5 5L20 7" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <h3
      class="mt-14 mb-6 text-2xl font-bold tracking-tight text-slate-900 dark:text-white"
    >
      Education
    </h3>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        education.map((ed) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-start justify-between gap-2">
              <h4 class="font-bold text-slate-900 dark:text-white">
                {ed.degree}
              </h4>
              <Badge>{ed.period}</Badge>
            </div>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              {ed.school} &middot; {ed.location}
            </p>
            {ed.detail && (
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
                {ed.detail}
              </p>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
