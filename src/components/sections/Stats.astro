---
import { getCollection } from 'astro:content';

const stats = (await getCollection('stats'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => e.data);
---

<section aria-label="Key metrics" class="border-y border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/50">
  <dl
    class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-10 px-6 py-12 sm:gap-8 lg:grid-cols-4"
  >
    {
      stats.map((stat) => (
        <div class="text-center">
          <dt class="sr-only">{stat.label}</dt>
          <dd>
            <span
              class="block text-4xl font-black tracking-tight text-transparent sm:text-5xl bg-gradient-to-r from-accent-500 to-brand-600 bg-clip-text dark:from-accent-300 dark:to-brand-400"
            >
              {stat.value}
            </span>
            <span
              class="mt-2 block text-sm font-medium text-slate-600 dark:text-slate-400"
            >
              {stat.label}
            </span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
