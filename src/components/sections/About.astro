---
import SectionHeading from '../SectionHeading.astro';
import { profile } from '../../data/site';

const { bio, beyondWork, focus } = profile;
---

<section
  id="about"
  class="mx-auto max-w-6xl scroll-mt-20 px-6 py-20"
  aria-labelledby="about-heading"
>
  <SectionHeading eyebrow="About" title="Building with AI, end to end" />

  <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
    <div class="space-y-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
      {bio.map((paragraph) => <p>{paragraph}</p>)}

      <div
        class="!mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900"
      >
        <h3 class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
          Beyond work
        </h3>
        <p class="mt-2 text-base text-slate-600 dark:text-slate-400">
          {beyondWork}
        </p>
      </div>
    </div>

    <div class="space-y-4">
      {
        focus.map((item) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 transition-colors hover:border-accent-400 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-accent-500/50">
            <h3 class="font-bold text-slate-900 dark:text-white">
              {item.title}
            </h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
              {item.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
